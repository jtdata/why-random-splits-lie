{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "MLFLOW_TRACKING_URI": "file:./mlruns",
    "PYTHONUTF8": "1"
  },
  "permissions": {
    "allow": [
      "Bash(uv sync)",
      "Bash(uv add:*)",
      "Bash(uv run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Read(//**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/kaggle.json)",
      "Bash(git push:*)",
      "Bash(rm -rf:*)",
      "Write(./data/raw/**)"
    ],
    "ask": [
      "Bash(uv remove:*)"
    ]
  }
}
